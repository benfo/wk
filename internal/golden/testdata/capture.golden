ey="rrfd:open:queue:::Oil the hinges" title="id rrfd"><svg class="ic s-todo" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Up next"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><div class="body"><div class="tt">Oil the hinges</div></div><span class="chip">core</span></li></ul></details><details class="g s-inbox" open><summary><svg class="ic s-inbox" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Inbox"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/><circle cx="7" cy="7" r="1.6" fill="currentColor"/></svg><b>Inbox, to sort</b><span class="c">2</span></summary><ul><li class="r" data-key="aes8:inbox::::A very long first line that keeps going and going well past the…" title="id aes8"><svg class="ic s-inbox" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Inbox"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/><circle cx="7" cy="7" r="1.6" fill="currentColor"/></svg><div class="body"><div class="tt">A very long first line that keeps going and going well past the seventy character title limit for sure</div></div></li><li class="r" data-key="xcma:inbox::::x" title="id xcma"><svg class="ic s-inbox" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Inbox"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/><circle cx="7" cy="7" r="1.6" fill="currentColor"/></svg><div class="body"><div class="tt">x</div></div></li></ul></details><details class="g s-later" open><summary><svg class="ic s-later" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Later"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/></svg><b>Later</b><span class="c">1</span></summary><ul><li class="r" data-key="4yrm:open:someday:::Idea: a