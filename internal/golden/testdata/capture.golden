ey="rrfd:open:queue:::Oil the hinges" title="id rrfd"><svg class="ic s-todo" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Up next"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><div class="body"><div class="tt">Oil the hinges</div></div><span class="chip">core</span></li></ul></details><details class="g s-inbox" open><summary><svg class="ic s-inbox" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Inbox"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/><circle cx="7" cy="7" r="1.6" fill="currentColor"/></svg><b>Inbox, to sort</b><span class="c">2</span></summary><ul><li class="r" data-key="aes8:inbox::::A very long first line that keeps going and going well past the…" title="id aes8"><svg class="ic s-inbox" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Inbox"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/><circle cx="7" cy="7" r="1.6" fill="currentColor"/></svg><div class="body"><div class="tt">A very long first line that keeps going and going well past the seventy character title limit for sure</div></div></li><li class="r" data-key="xcma:inbox::::x" title="id xcma"><svg class="ic s-inbox" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Inbox"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/><circle cx="7" cy="7" r="1.6" fill="currentColor"/></svg><div class="body"><div class="tt">x</div></div></li></ul></details><details class="g s-later" open><summary><svg class="ic s-later" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Later"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/></svg><b>Later</b><span class="c">1</span></summary><ul><li class="r" data-key="4yrm:open:someday:::Idea: a dark mode" title="id 4yrm"><svg class="ic s-later" width="14" height="14" viewBox="0 0 14 14" role="img" aria-label="Later"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 2.2"/></svg><div class="body"><div class="tt">Idea: a dark mode</div></div><span class="m">someday</span><span class="chip">core</span></li></ul></details></main>
<main class="tab tab-history"><details class="g" open><summary><b>Just happened</b><span class="c">10</span></summary><ul><li class="act" data-key="2026-11-10T09:00:00.000Zvn5cadded"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">added</span><span class="what">Sweep the path</span></li><li class="act" data-key="2026-11-10T09:00:00.000Zrrfdadded"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">added</span><span class="what">Oil the hinges</span></li><li class="act" data-key="2026-11-10T09:00:00.000Zxr8yadded"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">added</span><span class="what">Rake leaves</span></li><li class="act" data-key="2026-11-10T09:00:00.000Zxewhadded"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">added</span><span class="what">Fix hose</span></li><li class="act" data-key="2026-11-10T09:00:00.000Zm7swadded"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">added</span><span class="what">Buy seeds</span></li><li class="act" data-key="2026-11-10T09:00:00.000Zyebgsorted"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">sorted</span><span class="what">Bug: header overlaps</span></li><li class="act" data-key="2026-11-10T09:00:00.000Z4yrmsorted"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">sorted</span><span class="what">Idea: a dark mode</span></li><li class="act" data-key="2026-11-10T09:00:00.000Zyebgjotted"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">jotted</span><span class="what">Bug: header overlaps</span></li><li class="act" data-key="2026-11-10T09:00:00.000Zaes8jotted"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">jotted</span><span class="what">A very long first line that keeps going and going well past the seventy character title limit for sure</span></li><li class="act" data-key="2026-11-10T09:00:00.000Z4yrmjotted"><time class="ago" datetime="2026-11-10T09:00:00.000Z" data-prefix="" data-suffix=" ago">just now</time><span class="verb">jotted</span><span class="what">Idea: a dark mode</span></li></ul></details><details class="g" open><summary><b>Areas and principles</b><span class="c">1</span></summary><ul><li><details class="area"><summary><span>core</span><span class="c">7 open tasks, 0 principles</span></summary><div class="desc">Always in scope. Its principles load for every task; items with no better home live here.</div></details></li></ul></details></main>
